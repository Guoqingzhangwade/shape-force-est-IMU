+def sample_local_transverse_body_wrench(
+    force_range: float = 0.4,
+) -> tuple[np.ndarray, np.ndarray]:
+    """Sample force-only tip-body transverse load: f_b = [Fx, Fy, 0]."""
+    f_min = 0.25 * force_range
+    f_mag = np.random.uniform(f_min, force_range)
+    phi = np.random.uniform(0.0, 2.0 * np.pi)
+    f_body = np.array([f_mag * np.cos(phi), f_mag * np.sin(phi), 0.0])
+    l_body = np.zeros(3)
+    return f_body, l_body
+
+
+def sample_local_moment_body_wrench(
+    moment_range: float = 0.04,
+) -> tuple[np.ndarray, np.ndarray]:
+    """Sample moment-only tip-body load with random 3-D moment direction."""
+    m_min = min(0.005, 0.25 * moment_range)
+    m_max = min(0.035, 0.875 * moment_range)
+    if m_max <= m_min:
+        m_max = moment_range
+    m_mag = np.random.uniform(m_min, m_max)
+    direction = np.random.normal(size=3)
+    direction /= max(np.linalg.norm(direction), 1e-12)
+    f_body = np.zeros(3)
+    l_body = m_mag * direction
+    return f_body, l_body
+
